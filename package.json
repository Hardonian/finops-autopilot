{
  "name": "finops-autopilot",
  "version": "0.1.0",
  "description": "Runnerless FinOps autopilot for billing reconciliation, anomaly detection, and churn risk signals",
  "author": "AnomalyCo",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "finops": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "plan": "tsx src/cli.ts plan",
    "run": "tsx src/cli.ts run",
    "demo": "tsx src/cli.ts demo",
    "verify:fast": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "verify:full": "pnpm run verify:fast && pnpm run test",
    "docs:verify": "pnpm run build && tsx scripts/docs-verify.ts",
    "contracts:check": "tsx scripts/contracts-check.ts",
    "contracts:compat": "tsx scripts/contracts-compat.ts",
    "doctor": "tsx scripts/doctor.ts",
    "fixtures:export": "tsx scripts/fixtures-export.ts",
    "cost-risk:audit": "tsx scripts/cost-risk-audit.ts",
    "ci": "pnpm run verify:full && pnpm run contracts:check && pnpm run contracts:compat && pnpm run doctor && pnpm run cost-risk:audit",
    "runnerless:audit": "autopilot-audit runnerless . || echo 'Install @autopilot/runnerless-audit globally'",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@autopilot/contracts": "workspace:*",
    "@autopilot/jobforge-client": "workspace:*",
    "@autopilot/profiles": "workspace:*",
    "commander": "^15.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "finops",
    "billing",
    "reconciliation",
    "anomaly-detection",
    "churn-risk",
    "mrr",
    "stripe",
    "saas"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/finops-autopilot.git"
  },
  "pnpm": {
    "overrides": {
      "vitest@<3.2.6": "3.2.6",
      "vite@<6.4.3": "6.4.3",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "flatted@<=3.4.1": "3.4.2",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "postcss@<=8.5.17": "8.5.18",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "esbuild@<=0.24.2": "0.25.12",
      "brace-expansion@<1.1.18": "1.1.18",
      "postcss@<=8.5.22": "8.5.23",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "ajv@<6.14.0": "6.14.0"
    }
  }
}
